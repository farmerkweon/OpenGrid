{
  "name": "open-grid",
  "version": "1.6.0",
  "description": "초경량·제로 의존성 데이터 그리드 — React·Vue·Angular·jQuery·Vanilla 어디서나. 가상 스크롤·인라인 편집·다국어(i18n), MIT 라이선스, AI 친화 override 가이드. / Ultra-light data grid with a zero-dependency core — works with React, Vue, Angular, jQuery, or vanilla JS. Virtual scroll, inline editing, i18n. MIT-licensed, endlessly customizable, with an AI-friendly override guide.",
  "type": "module",
  "main": "dist/open-grid.cjs",
  "module": "dist/open-grid.js",
  "types": "dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "vue": [
        "./dist/types/vue/index.d.ts"
      ],
      "react": [
        "./dist/types/react/index.d.ts"
      ],
      "angular": [
        "./dist/angular/index.d.ts"
      ],
      "typography": [
        "./dist/types/typography/index.d.ts"
      ],
      "header": [
        "./dist/types/header/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/open-grid.js",
      "require": "./dist/open-grid.cjs"
    },
    "./vue": {
      "types": "./dist/types/vue/index.d.ts",
      "import": "./dist/open-grid-vue.js",
      "require": "./dist/open-grid-vue.cjs"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/open-grid-react.js",
      "require": "./dist/open-grid-react.cjs"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "default": "./dist/angular/fesm2022/open-grid-angular.mjs"
    },
    "./typography": {
      "types": "./dist/types/typography/index.d.ts",
      "import": "./dist/open-grid-typography.js",
      "require": "./dist/open-grid-typography.cjs"
    },
    "./typography.css": "./dist/open-grid-typography.css",
    "./header": {
      "types": "./dist/types/header/index.d.ts",
      "import": "./dist/open-grid-header.js",
      "require": "./dist/open-grid-header.cjs"
    },
    "./header.css": "./dist/open-grid-header.css",
    "./a11y": {
      "types": "./dist/types/a11y/index.d.ts",
      "import": "./dist/open-grid-a11y.js",
      "require": "./dist/open-grid-a11y.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.config.typography.ts && vite build --config vite.config.header.ts && vite build --config vite.config.a11y.ts && npm run build:angular",
    "build:angular": "npm --prefix angular install --no-audit --no-fund && npm --prefix angular run build && node -e \"require('fs').rmSync('dist/angular/esm2022',{recursive:true,force:true})\"",
    "build:types": "tsc --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs": "typedoc",
    "size": "node scripts/check-bundle-size.mjs",
    "arch:check": "node scripts/arch-check.mjs",
    "lint": "eslint src --ext .ts,.tsx,.vue",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "vue": ">=3.0.0",
    "@angular/core": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@angular/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "ajv": "^8.20.0",
    "eslint": "^9.0.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^1.6.0",
    "vue": "^3.4.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "keywords": [
    "grid",
    "datagrid",
    "table",
    "vue",
    "react",
    "angular",
    "typescript",
    "virtual-scroll",
    "editable"
  ],
  "license": "MIT",
  "author": "OPEN_GRID Contributors",
  "homepage": "https://foxnail.kr/open-grid/demo/v2/index.php",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farmerkweon/OpenGrid.git"
  },
  "bugs": {
    "url": "https://github.com/farmerkweon/OpenGrid/issues"
  }
}
